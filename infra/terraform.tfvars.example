# Copy to terraform.tfvars and adjust. No secrets belong here:
# the database password is generated by RDS and kept in Secrets Manager.
aws_region         = "us-east-1"
environment        = "dev"
container_image    = "ghcr.io/erick-6/slotly:latest"
allowed_http_cidrs = ["0.0.0.0/0"]
seed_demo_data     = true
