{
  "name": "slotly",
  "version": "1.0.0",
  "description": "Booking API for university lab equipment that makes double-booking impossible at the database level.",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/migrate.js --seed",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "setupFiles": ["./tests/env.js"],
    "globalSetup": "./tests/globalSetup.js"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
