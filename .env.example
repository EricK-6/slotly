# Optional: copy to .env to override the defaults in docker-compose.yml.
# `docker compose up` works without this file.

POSTGRES_USER=slotly
POSTGRES_PASSWORD=slotly
POSTGRES_DB=slotly

# Host ports
API_PORT=3000
DB_PORT=5432

# `npm test` uses its own database (created automatically). To point it elsewhere,
# export this in your shell:
# TEST_DATABASE_URL=postgres://slotly:slotly@localhost:5432/slotly_test
